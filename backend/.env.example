# BharatQuant AI - Environment Configuration

# Server Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./bharatquant.db

# Angel One SmartAPI Credentials
# Official documentation: https://smartapi.angelone.in/docs
ANGEL_ONE_API_KEY=your_smartapi_key_here
ANGEL_ONE_CLIENT_CODE=your_client_code_here
ANGEL_ONE_PIN=your_mpin_here
ANGEL_ONE_TOTP_SECRET=your_base32_totp_secret_here

# Risk Management Guardrails (Enforced on backend)
MAX_CAPITAL=1000000.0
MAX_RISK_PER_TRADE_PERCENT=2.0
DAILY_LOSS_LIMIT=25000.0
MAX_OPEN_POSITIONS=5
MIN_REWARD_TO_RISK_RATIO=1.5
KILL_SWITCH_ACTIVE=false

# Paper Trading Defaults
PAPER_INITIAL_CAPITAL=1000000.0
